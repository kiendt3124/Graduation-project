### 4. QUẢN LÝ DANH MỤC HỆ THỐNG
### ═══════════════════════════════════════════════════════════

### 4.1 Lấy tất cả danh mục (Admin view)
# @name adminGetCategories
GET {{host}}/api/admin/categories
Authorization: Bearer {{adminToken}}

> {%
    client.test("Lấy danh mục (admin) thành công", function () {
        client.assert(response.status === 200, "Expected 200 OK");
    });
%}

###

### 4.2 Tạo danh mục mới (EXPENSE)
# @name adminCreateExpenseCategory
POST {{host}}/api/admin/categories
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "name": "Giải trí",
  "icon": "🎮",
  "transactionType": "EXPENSE"
}

> {%
    client.test("Tạo danh mục EXPENSE thành công", function () {
        client.assert(response.status === 200, "Expected 200 OK");
    });
    if (response.status === 200) {
        client.global.set("adminCategoryId", response.body.id);
        client.global.set("expenseCategoryId", response.body.id);
        client.log("✅ adminCategoryId = " + response.body.id);
    }
%}

###

### 4.3 Tạo danh mục mới (INCOME)
### 💡 Chạy cái này để có incomeCategoryId cho module Transaction
# @name adminCreateIncomeCategory
POST {{host}}/api/admin/categories
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "name": "Lương",
  "icon": "💰",
  "transactionType": "INCOME"
}

> {%
    client.test("Tạo danh mục INCOME thành công", function () {
        client.assert(response.status === 200, "Expected 200 OK");
    });
    if (response.status === 200) {
        client.global.set("incomeCategoryId", response.body.id);
        client.log("✅ incomeCategoryId = " + response.body.id);
    }
%}

###

### 4.4 Cập nhật danh mục
# @name adminUpdateCategory
PATCH {{host}}/api/admin/categories
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "id": "{{adminCategoryId}}",
  "name": "Giải trí & Game",
  "icon": "🎯"
}

> {%
    client.test("Cập nhật danh mục thành công", function () {
        client.assert(response.status === 200, "Expected 200 OK");
    });
%}

###

### 4.5 Xóa danh mục
# @name adminDeleteCategory
DELETE {{host}}/api/admin/categories/{{adminCategoryId}}
Authorization: Bearer {{adminToken}}

> {%
    client.test("Xóa danh mục thành công", function () {
        client.assert(response.status === 200, "Expected 200 OK");
    });
%}

