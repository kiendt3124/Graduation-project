### 5.1 Lấy tất cả đối tác (Admin view)
# @name adminGetAllPartners
GET {{host}}/api/admin/partners
Authorization: Bearer {{adminToken}}

> {%
    client.test("Lấy đối tác (admin) thành công", function () {
        client.assert(response.status === 200, "Expected 200 OK");
    });
%}

###

### 5.2 Tạo đối tác mới
# @name adminCreatePartner
POST {{host}}/api/admin/partners
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "name": "Ngân hàng ABC Test",
  "logoUrl": "https://example.com/logo.png",
  "partnerType": "BANK",
  "loanInterestRate": 8.5,
  "savingInterestRate": 5.0,
  "description": "Ngân hàng test tạo từ HTTP client"
}

> {%
    client.test("Tạo đối tác thành công", function () {
        client.assert(response.status === 200, "Expected 200 OK");
    });
    if (response.status === 200) {
        client.global.set("adminPartnerId", response.body.id);
        client.log("✅ adminPartnerId = " + response.body.id);
    }
%}

###

### 5.3 Cập nhật đối tác
# @name adminUpdatePartner
PATCH {{host}}/api/admin/partners
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "id": "{{adminPartnerId}}",
  "loanInterestRate": 9.0,
  "description": "Đã cập nhật lãi suất vay"
}

> {%
    client.test("Cập nhật đối tác thành công", function () {
        client.assert(response.status === 200, "Expected 200 OK");
    });
%}

###

### 5.4 Toggle hiển thị đối tác
