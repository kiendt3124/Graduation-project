### ============================================================
### ADMIN — Giám sát AI
### ============================================================

### 9. Admin: xem tất cả AI logs
# @name adminGetAiLogs
GET {{host}}/api/admin/ai/logs?page=0&size=10
Authorization: Bearer {{adminToken}}

> {%
    client.test("Admin lấy AI logs thành công", function () {
        client.assert(response.status === 200, "Expected 200 OK");
    });
    if (response.status === 200) {
        client.log("📋 Tổng logs: " + response.body.totalElements);
    }
%}

###

### 10. Admin: xem AI error logs
# @name adminGetAiErrorLogs
GET {{host}}/api/admin/ai/logs?status=ERROR&page=0&size=10
Authorization: Bearer {{adminToken}}

> {%
    client.test("Admin lấy error logs thành công", function () {
        client.assert(response.status === 200, "Expected 200 OK");
    });
%}

###

### 11. Admin: thống kê AI
# @name adminGetAiStats
GET {{host}}/api/admin/ai/stats
Authorization: Bearer {{adminToken}}

> {%
    client.test("Admin lấy AI stats thành công", function () {
        client.assert(response.status === 200, "Expected 200 OK");
    });
    if (response.status === 200) {
        client.log("📊 Tổng requests: " + response.body.totalRequests);
        client.log("❌ Tỉ lệ lỗi: " + response.body.errorRate);
        client.log("🪙 Token đã dùng: " + response.body.totalTokensUsed);
        client.log("⏱️ Avg response: " + response.body.avgResponseMs + "ms");
    }
%}
