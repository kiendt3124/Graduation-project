### ============================================================
### AUTH MODULE — Đăng nhập, làm mới token, đăng xuất
### ============================================================
### 💡 DUY NHẤT 1 chỗ phải paste tay: Google ID Token ở bước 1
###    Cách lấy: Mở file test-google-login.html trong browser
###              → Đăng nhập Google → Copy ID Token → Paste vào dòng idToken bên dưới
###    Sau khi chạy xong bước 1, TẤT CẢ các file khác đều tự động 100%

### 1. Đăng nhập bằng Google
### ⚠️ Paste Google ID Token vào đây (lấy từ test-google-login.html)
# @name googleLogin
POST {{host}}/google
Content-Type: application/json

{
  "idToken": "eyJhbGciOiJSUzI1NiIsImtpZCI6IjgwNzZkZGJhYjQxNTU1NmUxNjkxNTRjNmE0YTBiZGJkNDQ2OWI3OWMiLCJ0eXAiOiJKV1QifQ..m6XFUFej7RDkZ3KhQ1UstBmW_fWzA82T2cqLPnX7108hS4bV8-Yuhms0wE4VU2j8QMJ7qcnx8uOCwKYFe8Usa_cbqd76qqsILal69IfH8ajT9WYEA1cnFdf76bJjiNTl4Tg62i4DmWiiwE9cjwPBVhSQGdnOvfZWffXPSL97LnZJH8SFm2XKRkNak1WL3Asxnz-Mxh8hEEep6SKF0XlRUJY5RN_XBYNH1js4GosONCMpa8HMoOTh0HjRKXuR0gKBMGeFzw9K5ZgFmhs3kPhUTgdG4yOSL6FVy2ZQ3aZFH02F-H11Q5mnEnyWee1dOJUO1K6D_jsiJfS2Hv0kcQM7gw"
}

> {%
    client.test("Google login thành công", function () {
        client.assert(response.status === 200, "Expected 200 OK");
    });
    if (response.status === 200) {
        client.global.set("accessToken", response.body.accessToken);
        client.global.set("refreshToken", response.body.refreshToken);
        client.log("✅ Đã lưu accessToken & refreshToken");
    }
%}

###

### 2. Đăng nhập Admin
# @name adminLogin
POST {{host}}/admin/login
Content-Type: application/json

{
  "username": "{{admin_username}}",
  "password": "{{admin_password}}"
}

> {%
    client.test("Admin login thành công", function () {
        client.assert(response.status === 200, "Expected 200 OK");
    });
    if (response.status === 200) {
        client.global.set("adminToken", response.body.accessToken);
        client.global.set("adminRefreshToken", response.body.refreshToken);
        client.log("✅ Đã lưu adminToken");
    }
%}

###

### 3. Làm mới access token
# @name refreshToken
POST {{host}}/refresh-token
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}

> {%
    client.test("Refresh token thành công", function () {
        client.assert(response.status === 200, "Expected 200 OK");
    });
    if (response.status === 200) {
        client.global.set("accessToken", response.body.accessToken);
        client.global.set("refreshToken", response.body.refreshToken);
        client.log("✅ Đã cập nhật token mới");
    }
%}

###

### 4. Kiểm tra token (me)
GET {{host}}/me
Authorization: Bearer {{accessToken}}

> {%
    client.test("Token hợp lệ", function () {
        client.assert(response.status === 200, "Expected 200 OK");
    });
%}

###

### 5. Đăng xuất
POST {{host}}/logout
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "refreshToken": "{{refreshToken}}"
}

> {%
    client.test("Logout thành công", function () {
        client.assert(response.status === 200, "Expected 200 OK");
    });
%}
